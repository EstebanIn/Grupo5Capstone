# Copiar como .env (no se versiona). Sin POSTGRES_DB, Django usa SQLite.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=edugestor
POSTGRES_USER=edugestor
POSTGRES_PASSWORD=edugestor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Asistentes de IA. Sin GEMINI_API_KEY se usa el modo simulado.
# Key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODELOS_RESPALDO=gemini-flash-lite-latest

# Embeddings para búsqueda semántica curricular (RAG).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001


# Qwen (Model Studio). La clave debe pertenecer a la región del endpoint.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_EMBEDDING_MODEL=text-embedding-v4
